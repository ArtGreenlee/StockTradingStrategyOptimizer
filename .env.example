# Alpaca PAPER trading API credentials.
# Get them from https://app.alpaca.markets/  ->  "Paper Trading"  ->  "API Keys"
# These are PAPER keys. The bot only ever talks to the paper endpoint.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Ticker the bot trades (single symbol).
TICKER=AAPL

# Max shares the bot may hold at once (keeps trades small).
MAX_POSITION_SHARES=10

# Shares per individual order.
ORDER_QTY=1

# How often (seconds) the bot pulls new data and re-evaluates.
POLL_INTERVAL_SECONDS=15

# How many minutes of historical 1-min bars to load for indicators/plotting.
LOOKBACK_MINUTES=390

# ----------------------------------------------------------------------------
# Proxy / corporate network (optional).
# Leave these blank for a direct internet connection. Behind a corporate
# firewall, set PROXY_URL to your forward proxy. Credentials may be embedded
# as http://user:pass@host:port and are masked in the GUI/logs.
# ----------------------------------------------------------------------------

# Single proxy applied to both HTTP and HTTPS (most common case).
PROXY_URL=

# Optional per-scheme overrides (take precedence over PROXY_URL).
HTTP_PROXY=
HTTPS_PROXY=

# Comma-separated hosts/domains that should bypass the proxy.
NO_PROXY=

# Path to your corporate root CA bundle (PEM). Use this for proxies that do
# TLS interception -- it is the SECURE alternative to disabling verification.
PROXY_CA_BUNDLE=

# Set to false ONLY as a last resort if TLS verification fails and you cannot
# obtain a CA bundle. This is insecure and flagged loudly in the GUI/logs.
PROXY_VERIFY_SSL=true

# ----------------------------------------------------------------------------
# Options data feed for Unusual Options Activity (UOA) detection.
#   indicative = free, ~15-min delayed (default; works on paper accounts)
#   opra       = real-time, requires an OPRA market-data subscription
# If your account has no options data entitlement, the bot degrades gracefully
# and simply shows "Options flow unavailable".
# ----------------------------------------------------------------------------
OPTIONS_FEED=indicative

# ----------------------------------------------------------------------------
# LLM / Copilot endpoint for the Orchestrator tab (sentiment analysis).
# Any OpenAI-compatible chat endpoint works: OpenAI, Azure OpenAI, GitHub
# Models, or a corporate Copilot gateway. Requests reuse the proxy settings
# above. Leave blank to disable the Orchestrator (it degrades gracefully).
#
#   OpenAI:        LLM_BASE_URL=https://api.openai.com/v1
#   GitHub Models: LLM_BASE_URL=https://models.inference.ai.azure.com
#   Azure OpenAI:  LLM_BASE_URL=https://<resource>.openai.azure.com
#                  LLM_MODEL=<your-deployment-name>
#                  LLM_API_VERSION=2024-06-01   (set this -> Azure URL + api-key header)
# ----------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_API_VERSION=

# ----------------------------------------------------------------------------
# Anthropic (Claude) endpoint -- e.g. Claude served via a Databricks serving
# endpoint. When ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN are set, the
# Orchestrator uses the Anthropic Messages API and IGNORES the LLM_* vars above.
# Requests reuse the proxy settings. ANTHROPIC_AUTH_TOKEN -> "Authorization:
# Bearer <token>". ANTHROPIC_CUSTOM_HEADERS holds extra "Name: Value" headers
# (newline-separated for multiple).
# ----------------------------------------------------------------------------
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=your_anthropic_token_here
ANTHROPIC_MODEL=
ANTHROPIC_CUSTOM_HEADERS=
ANTHROPIC_VERSION=2023-06-01

